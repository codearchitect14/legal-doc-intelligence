# Environment: local | staging | production
ENVIRONMENT=local

# Database (host port 5435 to avoid colliding with other local projects' Postgres containers)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/legal_doc_intelligence

# Redis (host port 6381 to avoid colliding with other local projects' Redis containers)
REDIS_URL=redis://localhost:6381/0

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers (see backend/app/llm)
GROQ_API_KEY=replace-with-your-groq-key
GEMINI_API_KEY=replace-with-your-gemini-key
LLM_PREFERRED_PROVIDER=groq

# Object storage for raw uploaded files
OBJECT_STORAGE_PATH=./data/uploads
